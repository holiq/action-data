    //
    // Immutable overrides — with() uses named arguments (IDE autocomplete friendly):
    //   $updated = $dto->with(email: 'new@example.com');
    //   $updated = $dto->with(name: 'Jane', email: 'jane@example.com');
    //
    // withArray() accepts snake_case or camelCase array keys:
