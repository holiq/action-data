    // -------------------------------------------------------------------------
    // Usage examples
    // -------------------------------------------------------------------------
    //
    // Resolve from various sources:
    //   $dto = {{ class }}::resolve(['first_name' => 'John', 'email' => 'john@example.com']);
    //   $dto = {{ class }}::resolveFrom($request);   // FormRequest
    //   $dto = {{ class }}::resolveFrom($model);     // Eloquent Model
