    //   $cleared = $dto->without('avatar', 'password');
    //
    // All three methods are chainable with each other:
    //   $result = $dto
    //       ->with(name: 'Jane')
    //       ->withArray(['email' => 'jane@example.com'])
    //       ->without('avatar');
    //
    // Output formats:
    //   $dto->toArray();           // snake_case keys  → for database
    //   $dto->toArrayForCreate();  // excludes toExcludedPropertiesOnCreate()
    //   $dto->toArrayForUpdate();  // excludes toExcludedPropertiesOnUpdate()
    //   $dto->toCamelCase();       // camelCase keys   → for API responses
    //   $dto->toJson();            // JSON snake_case
    //   $dto->toCamelJson();       // JSON camelCase
